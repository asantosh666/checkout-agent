# Copy to .env and fill in. Never commit .env.
# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Gemini API key (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Public base URL of this app (used for PayPal return_url).
# Local dev: http://localhost:8000 ; hosted demo: your https URL.
APP_BASE_URL=http://localhost:8000
